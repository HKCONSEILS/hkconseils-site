---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  originalDate: Date;
  slug: string;
}
const { title, description, pubDate, originalDate, slug } = Astro.props;
const canonical = `https://hkconseils.fr/blog/${slug}/`;

const fr = (d: Date) =>
  d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });

// L'auteur et l'éditeur pointent vers les nœuds déjà présents dans le @graph de
// la page d'accueil, plutôt que d'en redéclarer des copies : une seule entité
// Person et une seule entité ProfessionalService pour tout le site.
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString().slice(0, 10),
  dateModified: pubDate.toISOString().slice(0, 10),
  inLanguage: 'fr-FR',
  mainEntityOfPage: canonical,
  author: { '@id': 'https://hkconseils.fr/#hemerson-koffi' },
  publisher: { '@id': 'https://hkconseils.fr/#organisation' },
};
---
<Base title={`${title} · HK CONSEILS`} description={description} canonical={canonical} ogType="article">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonld, null, 2)} is:inline />

  <article class="section article">
    <div class="wrap">
      <p class="eyebrow">Article</p>
      <h1>{title}</h1>
      <p class="chapo">{description}</p>
      <p class="article-meta">
        Publié le <time datetime={pubDate.toISOString().slice(0, 10)}>{fr(pubDate)}</time>.
        Publié initialement sur LinkedIn le {fr(originalDate)}.
      </p>
      <div class="prose">
        <slot />
      </div>
      <p class="article-retour"><a href="/blog/">Retour à la liste des articles</a></p>
    </div>
  </article>
</Base>

<style>
  .article h1 {
    font-size: clamp(1.85rem, 4.2vw, 2.6rem);
    line-height: 1.15;
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-3);
    max-width: 22ch;
    text-wrap: balance;
  }
  .chapo {
    font-size: var(--text-lead);
    line-height: var(--leading-relaxed);
    color: var(--color-fg);
    max-width: var(--measure);
    margin-bottom: var(--space-2);
  }
  .article-meta {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-fg-muted);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }
  .prose { margin-top: var(--space-6); }
  .prose :global(h2) {
    font-size: 1.375rem;
    line-height: var(--leading-snug);
    letter-spacing: -0.015em;
    margin-top: var(--space-8);
    margin-bottom: var(--space-1);
  }
  .prose :global(h3) {
    font-size: 1.0625rem;
    margin-top: var(--space-6);
    margin-bottom: var(--space-1);
  }
  .prose :global(p),
  .prose :global(li) { max-width: var(--measure); color: var(--color-fg-muted); }
  .prose :global(p) { margin-bottom: var(--space-2); }
  .prose :global(ul),
  .prose :global(ol) { padding-left: 1.2em; margin-bottom: var(--space-3); list-style: disc; }
  .prose :global(ol) { list-style: decimal; }
  .prose :global(li) { margin-bottom: 6px; }
  .prose :global(strong) { color: var(--color-fg); font-weight: 600; }
  .prose :global(pre) {
    background: var(--hk-navy);
    color: rgba(255, 255, 255, 0.92);
    border-radius: var(--radius-sm);
    padding: var(--space-3);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.7;
    margin-bottom: var(--space-3);
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--color-surface-sunken);
    padding: 1px 5px;
    border-radius: 3px;
  }
  .prose :global(pre code) { background: none; padding: 0; color: inherit; }
  .prose :global(blockquote) {
    border-left: 3px solid var(--hk-blue);
    padding-left: var(--space-3);
    margin: var(--space-3) 0;
  }
  .prose :global(img) { border-radius: var(--radius-sm); border: 1px solid var(--color-border); }
  .prose :global(table) { width: 100%; border-collapse: collapse; font-size: var(--text-small); }
  .prose :global(th) {
    text-align: left;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-fg-muted);
    border-bottom: 1px solid var(--color-border);
    padding: 0 12px 8px 0;
  }
  .prose :global(td) { border-bottom: 1px solid var(--color-border); padding: 10px 12px 10px 0; }
  .article-retour { margin-top: var(--space-8); font-size: var(--text-small); }
</style>
