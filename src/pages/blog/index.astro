---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const fr = (d: Date) =>
  d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base
  title="Blog · HK CONSEILS"
  description="Retours d'expérience sur l'IA générative auto-hébergée : infrastructure d'inférence, dimensionnement, sécurité et coûts réels."
  canonical="https://hkconseils.fr/blog/"
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Blog</p>
      <h1>Retours d'expérience</h1>
      <p class="lead">
        Ce qui se passe quand on construit soi-même une plateforme d'inférence :
        les mesures, les arbitrages, les incidents et ce qu'ils coûtent vraiment.
      </p>

      {posts.length === 0 ? (
        <p class="vide">Les premiers articles arrivent.</p>
      ) : (
        <ul class="liste">
          {posts.map((post) => (
            <li>
              <article>
                <p class="date">
                  <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>
                    {fr(post.data.pubDate)}
                  </time>
                </p>
                <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
                <p>{post.data.description}</p>
              </article>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</Base>

<style>
  h1 {
    font-size: clamp(1.85rem, 4.2vw, 2.6rem);
    line-height: 1.15;
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-3);
  }
  .liste { margin-top: var(--space-8); border-top: 1px solid var(--color-border); }
  .liste li { border-bottom: 1px solid var(--color-border); padding-block: var(--space-4); }
  .liste .date {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-fg-muted);
    margin-bottom: var(--space-1);
  }
  .liste h2 { font-size: 1.25rem; line-height: var(--leading-snug); margin-bottom: var(--space-1); }
  .liste h2 a { color: var(--color-fg); text-decoration: none; }
  .liste h2 a:hover { color: var(--color-accent); text-decoration: underline; }
  .liste p { color: var(--color-fg-muted); font-size: var(--text-small); }
  .vide {
    margin-top: var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--color-fg-muted);
  }
</style>
